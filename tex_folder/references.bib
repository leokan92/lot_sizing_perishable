@InProceedings{Hendrix2012,
author="Hendrix, Eligius M. T.
and Haijema, Rene
and Rossi, Roberto
and Pauls-Worm, Karin G. J.",
editor="Murgante, Beniamino
and Gervasi, Osvaldo
and Misra, Sanjay
